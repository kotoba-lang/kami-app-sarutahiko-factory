 :prod-order/takt-s 45
 :prod-order/stations
 [{:station/seq 1 :station/id "st:receive" :station/name "Receive"
   :station/layer "body-in-white" :station/op "receive"
   :station/x 5.0 :station/y 25.0 :station/cell "" :station/cycle-s 30.0}
