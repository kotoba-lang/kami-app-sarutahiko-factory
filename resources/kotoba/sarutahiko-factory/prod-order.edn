  {:station/seq 4 :station/id "st:marriage" :station/name "Marriage"
   :station/layer "chassis" :station/op "marriage"
   :station/x 75.0 :station/y 25.0 :station/cell "" :station/cycle-s 40.0}
  {:station/seq 5 :station/id "st:ship" :station/name "Ship"
